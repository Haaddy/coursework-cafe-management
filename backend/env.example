# Скопируйте в backend/.env и задайте свои значения.

PORT=3001

# Менеджер из БД: personal_code + общий пароль
ADMIN_PASSWORD=change-me

# Владелец без записи в БД (логин в поле «код сотрудника» на странице входа)
ADMIN_OWNER_LOGIN=owner
ADMIN_OWNER_PASSWORD=change-me-too
ADMIN_OWNER_NAME=Владелец
